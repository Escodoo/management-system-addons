<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- List View for BPMN Template Category -->
    <record id="bpmn_template_category_view_tree" model="ir.ui.view">
        <field name="name">bpmn.template.category.view.list</field>
        <field name="model">bpmn.template.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="template_count" />
            </list>
        </field>
    </record>

    <!-- Form View for BPMN Template Category -->
    <record id="bpmn_template_category_view_form" model="ir.ui.view">
        <field name="name">bpmn.template.category.view.form</field>
        <field name="model">bpmn.template.category</field>
        <field name="arch" type="xml">
            <form string="Template Category">
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="sequence" />
                        </group>
                        <group>
                            <field name="template_count" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field
                                name="description"
                                placeholder="Describe this category..."
                            />
                        </page>
                        <page string="Templates">
                            <field name="template_ids" readonly="1">
                                <list>
                                    <field name="name" />
                                    <field name="is_public" />
                                    <field name="usage_count" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View for BPMN Template -->
    <record id="bpmn_template_view_tree" model="ir.ui.view">
        <field name="name">bpmn.template.view.list</field>
        <field name="model">bpmn.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="category_id" />
                <field name="is_public" />
                <field name="usage_count" />
                <field name="active" invisible="1" />
            </list>
        </field>
    </record>

    <!-- Form View for BPMN Template -->
    <record id="bpmn_template_view_form" model="ir.ui.view">
        <field name="name">bpmn.template.view.form</field>
        <field name="model">bpmn.template</field>
        <field name="arch" type="xml">
            <form string="BPMN Template">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_use_template"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-play"
                        >
                            <field name="usage_count" widget="statinfo" string="Used" />
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="category_id" />
                            <field name="icon" />
                            <field name="sequence" />
                        </group>
                        <group>
                            <field name="is_public" />
                            <field name="active" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field
                                name="description"
                                placeholder="Describe what this template is used for..."
                            />
                        </page>
                        <page string="BPMN XML">
                            <field
                                name="xml_content"
                                widget="text"
                                nolabel="1"
                                placeholder="BPMN XML content..."
                            />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Kanban View for BPMN Template -->
    <record id="bpmn_template_view_kanban" model="ir.ui.view">
        <field name="name">bpmn.template.view.kanban</field>
        <field name="model">bpmn.template</field>
        <field name="arch" type="xml">
            <kanban default_order="sequence">
                <field name="name" />
                <field name="category_id" />
                <field name="icon" />
                <field name="usage_count" />
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <i
                                                t-attf-class="fa {{record.icon.raw_value or 'fa-file-o'}}"
                                            />
                                            <field name="name" />
                                        </strong>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <field name="description" />
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="category_id" />
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <span class="badge badge-pill">
                                            <field name="usage_count" /> uses
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Tree View for DMN Diagram Category -->
    <record id="dmn_diagram_category_view_tree" model="ir.ui.view">
        <field name="name">dmn.diagram.category.view.tree</field>
        <field name="model">dmn.diagram.category</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="diagram_count" />
            </tree>
        </field>
    </record>

    <!-- Form View for DMN Diagram Category -->
    <record id="dmn_diagram_category_view_form" model="ir.ui.view">
        <field name="name">dmn.diagram.category.view.form</field>
        <field name="model">dmn.diagram.category</field>
        <field name="arch" type="xml">
            <form string="Diagram Category">
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="sequence" />
                        </group>
                        <group>
                            <field name="diagram_count" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field
                                name="description"
                                placeholder="Describe this category..."
                            />
                        </page>
                        <page string="Diagrams">
                            <field name="diagram_ids" readonly="1">
                                <tree>
                                    <field name="name" />
                                    <field name="version" />
                                    <field name="state" widget="badge" />
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
